# Kopieer naar .env (lokaal) of zet deze waarden in deploy/ecosystem.config.cjs.

# Poort waar Node op luistert. In CloudPanel: dezelfde "App Port" als bij de site.
PORT=3000
# 127.0.0.1 = alleen bereikbaar via nginx op dezelfde server (aanbevolen in productie).
HOST=127.0.0.1

# Welke pagina's een WebSocket mogen openen (komma-gescheiden, exact).
# Leeg = alleen dezelfde host als waar de pagina vandaan komt.
ALLOWED_ORIGINS=https://games.tkriek.dev

# Maximaal aantal kamers tegelijk op de server.
MAX_ROOMS=500

# error | warn | info | debug
LOG_LEVEL=info

# --- Optioneel -------------------------------------------------------------
# Max. gelijktijdige verbindingen en kamers per IP (let op: een hele klas op
# school deelt vaak één IP-adres).
# MAX_CONN_PER_IP=24
# MAX_ROOMS_PER_IP=8
# CONNECTS_PER_MINUTE=60
# ROOMS_PER_MINUTE=12
# MAX_CONNECTIONS=3000

# Proxy-headers (CF-Connecting-IP / X-Forwarded-For) vertrouwen:
# loopback (standaard) = alleen als het verzoek van 127.0.0.1 komt (nginx)
# always | never
# TRUST_PROXY=loopback

# Normaal schrijft deploy.sh een .build-id; dit overschrijft die.
# BUILD_ID=
